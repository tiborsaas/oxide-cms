# Server Configuration
HOST=127.0.0.1
PORT=3000

# SQLite Database (for local cargo run, points to ./data/oxide_cms.db)
DATABASE_URL=sqlite:data/oxide_cms.db

# Docker Persistent Storage Volume
# - Local dev (default): ./data (mounts host ./data to container /data for SQL client inspection)
# - Production server: oxide_cms_data (Docker named volume persisted on server disk)
DATA_VOLUME=./data

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_secret_pass

# JWT Secret for Session Tokens
JWT_SECRET=super_secret_headless_cms_jwt_key_change_in_prod
